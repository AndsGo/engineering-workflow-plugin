#!/usr/bin/env bash
# Setup script for engineering-workflow plugin
# Usage: ./setup [--global | --project | --check]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_NAME="engineering-workflow"

echo "=== Engineering Workflow Plugin Setup ==="
echo ""

# --- Parse args ---
MODE="${1:-}"

show_help() {
  echo "Usage: ./setup [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  --global     Install to ~/.claude/plugins/$PLUGIN_NAME (all projects)"
  echo "  --project    Install to .claude/plugins/$PLUGIN_NAME (current project only)"
  echo "  --check      Check dependencies without installing"
  echo "  --uninstall  Remove the plugin"
  echo "  (no args)    Interactive mode — choose install location"
  echo ""
}

check_dependencies() {
  echo "Checking dependencies..."
  echo ""

  # Required: Superpowers
  sp_found="false"
  if [ -d "${HOME}/.claude/plugins/cache" ]; then
    sp_cache=$(find "${HOME}/.claude/plugins/cache" -path "*/superpowers/*" -name "SKILL.md" 2>/dev/null | head -1)
    [ -n "$sp_cache" ] && sp_found="true"
  fi
  for sp_path in "${HOME}/.claude/skills/superpowers" ".claude/skills/superpowers" ".claude/plugins/superpowers"; do
    [ -d "$sp_path" ] 2>/dev/null && sp_found="true" && break
  done
  if grep -rq "superpowers" "${HOME}/.claude/settings.json" 2>/dev/null || \
     grep -rq "superpowers" ".claude/settings.local.json" 2>/dev/null; then
    sp_found="true"
  fi

  if [ "$sp_found" = "true" ]; then
    echo "  [OK] Superpowers plugin detected"
  else
    echo "  [!!] Superpowers plugin NOT FOUND (required)"
    echo "       Install: /plugin marketplace add obra/superpowers-marketplace"
    echo "       Then:    /plugin install superpowers@superpowers-marketplace"
  fi

  # Optional: agent-browser
  if command -v agent-browser >/dev/null 2>&1; then
    echo "  [OK] agent-browser CLI"
  else
    echo "  [--] agent-browser CLI not found (optional, for e2e-browser-test)"
    echo "       Install: npm install -g agent-browser && agent-browser install"
  fi

  # Optional: gh CLI
  if command -v gh >/dev/null 2>&1; then
    echo "  [OK] gh CLI"
  else
    echo "  [--] gh CLI not found (optional, for resolve-pr-feedback)"
    echo "       Install: https://cli.github.com/"
  fi

  # Optional: git
  if command -v git >/dev/null 2>&1; then
    echo "  [OK] git"
  else
    echo "  [!!] git not found (required for most skills)"
  fi

  echo ""
}

install_to() {
  local target="$1"
  echo "Installing to: $target"

  if [ -d "$target" ]; then
    echo "  Existing installation found. Updating..."
    rm -rf "$target"
  fi

  mkdir -p "$(dirname "$target")"
  cp -r "$SCRIPT_DIR" "$target"

  # Remove .git if present (don't copy repo history into install)
  rm -rf "$target/.git"

  # Set hook permissions (no-op on Windows NTFS, but needed for Linux/macOS)
  chmod +x "$target/hooks/session-start" "$target/hooks/pre-commit-gate" "$target/hooks/run-hook.cmd" "$target/setup" 2>/dev/null || true

  echo "  Done!"
  echo ""
  echo "  To use: start a new Claude Code session in any project."
  echo "  The plugin loads automatically."
  echo ""
}

uninstall() {
  echo "Uninstalling..."
  local removed=0

  if [ -d "${HOME}/.claude/plugins/$PLUGIN_NAME" ]; then
    rm -rf "${HOME}/.claude/plugins/$PLUGIN_NAME"
    echo "  Removed global install: ~/.claude/plugins/$PLUGIN_NAME"
    removed=1
  fi

  if [ -d ".claude/plugins/$PLUGIN_NAME" ]; then
    rm -rf ".claude/plugins/$PLUGIN_NAME"
    echo "  Removed project install: .claude/plugins/$PLUGIN_NAME"
    removed=1
  fi

  if [ $removed -eq 0 ]; then
    echo "  No installation found."
  fi
  echo ""
}

# --- Main ---
case "${MODE}" in
  --help|-h)
    show_help
    ;;
  --check)
    check_dependencies
    ;;
  --global)
    check_dependencies
    install_to "${HOME}/.claude/plugins/$PLUGIN_NAME"
    ;;
  --project)
    check_dependencies
    install_to ".claude/plugins/$PLUGIN_NAME"
    ;;
  --uninstall)
    uninstall
    ;;
  *)
    check_dependencies
    echo "Where do you want to install?"
    echo "  1) Global (~/.claude/plugins/$PLUGIN_NAME) — all projects"
    echo "  2) Project (.claude/plugins/$PLUGIN_NAME) — this project only"
    echo "  3) Cancel"
    echo ""
    printf "Choose [1/2/3]: "
    read -r choice
    case "$choice" in
      1) install_to "${HOME}/.claude/plugins/$PLUGIN_NAME" ;;
      2) install_to ".claude/plugins/$PLUGIN_NAME" ;;
      *) echo "Cancelled." ;;
    esac
    ;;
esac
